# Template. Do not put real credentials here, and do not commit a .env file.
# The API reads OPENAI_API_KEY and TREMORBAND_MODEL from the environment.
# If OPENAI_API_KEY is set and TREMORBAND_MODEL is unset, the model is openai:gpt-4o-mini.
# If OPENAI_API_KEY is unset, the API keeps the scripted model.
# Set TREMORBAND_MODEL to a provider:model string to choose a different hosted model.

WIFI_SSID=
WIFI_PASSWORD=
OPENAI_API_KEY=
TREMORBAND_MODEL=
